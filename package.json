{
  "name": "escuta",
  "private": true,
  "version": "1.0.0",
  "description": "Ouvidoria digital com denúncias anônimas para escolas e faculdades (ODS 16).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "emuladores": "npx firebase-tools emulators:start --project demo-escuta",
    "seed": "node scripts/seed.mjs",
    "test": "vitest run tests/unidade",
    "test:regras": "npx firebase-tools emulators:exec --only firestore,auth --project demo-escuta \"vitest run tests/regras\"",
    "deploy": "npm run build && npx firebase-tools deploy"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "firebase": "^13.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "firebase-admin": "^14.5.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
